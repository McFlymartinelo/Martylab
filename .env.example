# =============================================================================
# Martylab environment example
# Copy to .env and adapt. Never commit .env.
# =============================================================================

NODE_ENV=production

# Portal host port (Debian). Does not conflict with Matchday :3000.
PORTAL_HOST_PORT=3100

# Backend (internal container listen address — not published on the host)
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Browser origin for CORS / Origin checks.
# Production HTTPS (Cloudflare Tunnel):
CORS_ORIGIN=https://martylab.martylab.fr
# HTTP smoke test on the server before Tunnel:
# CORS_ORIGIN=http://127.0.0.1:3100
# Local Windows Vite dev:
# CORS_ORIGIN=http://localhost:5173

# PostgreSQL
POSTGRES_DB=martylab
POSTGRES_USER=martylab
POSTGRES_PASSWORD=change-me-strong-password
# Docker Compose (backend -> postgres service):
DATABASE_URL=postgresql://martylab:change-me-strong-password@postgres:5432/martylab
# Local Windows / host tooling instead:
# DATABASE_URL=postgresql://martylab:change-me-strong-password@localhost:5432/martylab

# Auth sessions
# Production: generate with scripts/generate-session-secret.sh
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SESSION_COOKIE_NAME=martylab_session
SESSION_TTL_DAYS=7

# Cookie Secure flag (explicit, not hardcoded in app logic beyond env default)
# Production HTTPS:
COOKIE_SECURE=true
# Local HTTP tests (e.g. http://SERVER:3100):
# COOKIE_SECURE=false

# Seed passwords (optional one-shot)
SEED_ALEXANDRE_PASSWORD=changeme-alexandre
SEED_INVITE_PASSWORD=changeme-invite

# Host metrics + Docker (production Debian — see compose.yaml backend volumes)
# HOST_PROC_PREFIX=/host/proc
# HOST_SYS_PREFIX=/host/sys
# HOST_ROOT_PATH=/host/root
# DOCKER_SOCKET_PATH=/var/run/docker.sock
# DOCKER_GID=999

# Orion (application indépendante — https://orion.martylab.fr)
# ORION_URL=https://orion.martylab.fr
# ORION_PUBLIC_URL=https://orion.martylab.fr
# ORION_API_KEY=
# Local dev if Orion runs on :4000:
# ORION_URL=http://localhost:4000

# Matchday (application indépendante — https://matchday.martylab.fr)
# MATCHDAY_URL=https://matchday.martylab.fr
# MATCHDAY_PUBLIC_URL=https://matchday.martylab.fr
# MATCHDAY_GROUP_ID=1
# MATCHDAY_SERVICE_USERNAME=martylab
# MATCHDAY_SERVICE_PASSWORD=change-me-service-password
# Optional — login as Matchday user for personalized pending predictions (JSON, keys = Martylab username):
# MATCHDAY_USER_PASSWORDS={"alexandre":"matchday-password"}
# MATCHDAY_TIMEOUT_MS=6000

# Portainer
# PORTAINER_URL=https://portainer.martylab.fr
# PORTAINER_API_TOKEN=ptr_...
# PORTAINER_ENDPOINT_ID=1
# PORTAINER_INSECURE_TLS=false

# Cloudflare (monitoring tunnel + domaines)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_TUNNEL_ID=
# CLOUDFLARE_CHECK_HOSTNAMES=martylab.martylab.fr,orion.martylab.fr,matchday.martylab.fr

# NAS UGREEN (token UGOS — voir docs/infrastructure-connectors.md)
# NAS_URL=https://192.168.x.x:9443
# NAS_API_TOKEN=
# NAS_INSECURE_TLS=true
