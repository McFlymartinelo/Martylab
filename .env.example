# =============================================================================
# Martylab environment example
# Copy to .env and adapt. Never commit .env.
# =============================================================================

NODE_ENV=production

# Portal host port (Debian). Does not conflict with Matchday :3000.
PORTAL_HOST_PORT=3100

# Backend (internal container listen address — not published on the host)
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Browser origin for CORS / Origin checks.
# Production (behind Cloudflare Tunnel later):
CORS_ORIGIN=https://martylab.martylab.fr
# Local Windows Vite dev instead:
# CORS_ORIGIN=http://localhost:5173

# PostgreSQL
POSTGRES_DB=martylab
POSTGRES_USER=martylab
POSTGRES_PASSWORD=change-me-strong-password
# Docker Compose (backend -> postgres service):
DATABASE_URL=postgresql://martylab:change-me-strong-password@postgres:5432/martylab
# Local Windows / host tooling instead:
# DATABASE_URL=postgresql://martylab:change-me-strong-password@localhost:5432/martylab

# Auth sessions
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SESSION_COOKIE_NAME=martylab_session
SESSION_TTL_DAYS=7

# Cookie Secure flag (explicit, not hardcoded in app logic beyond env default)
# Production HTTPS:
COOKIE_SECURE=true
# Local HTTP tests (e.g. http://SERVER:3100):
# COOKIE_SECURE=false

# Seed passwords (optional one-shot)
SEED_ALEXANDRE_PASSWORD=changeme-alexandre
SEED_INVITE_PASSWORD=changeme-invite
