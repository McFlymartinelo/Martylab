# Martylab backend
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL
POSTGRES_PASSWORD=martylab
DATABASE_URL=postgresql://martylab:martylab@localhost:5432/martylab

# Auth sessions (required in production, min 32 chars)
SESSION_SECRET=dev-only-martylab-session-secret-change-me
SESSION_COOKIE_NAME=martylab_session
SESSION_TTL_DAYS=7

# Seed passwords (development defaults are applied only if unset)
SEED_ALEXANDRE_PASSWORD=changeme-alexandre
SEED_INVITE_PASSWORD=changeme-invite
